--[[
	LOADING SCREEN (client only)
	Put this as a LocalScript inside StarterPlayer > StarterPlayerScripts.
	Everything is created with Instance.new.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local ContentProvider = game:GetService("ContentProvider")

if not RunService:IsClient() then
	return
end

local player = Players.LocalPlayer
if not player then
	return
end
local playerGui = player:WaitForChild("PlayerGui")

---------------------------------------------------------------------
-- SETTINGS
---------------------------------------------------------------------
local LOAD_TIME = 20 -- seconds before everything fades away
local FADE_TIME = 2 -- fade out length

local ID_UI = 137601637193496 -- clickable UI
local ID_TEXTURE = 124245863273672 -- centre texture (splits in half)
local ID_ZOOM = 5639840621 -- zoom texture

local SND_MUSIC = "rbxassetid://72920793923555"
local SND_FINISH = "rbxassetid://144130832"
local SND_CLICK = "rbxassetid://126396290599122"

local CENTER = UDim2.fromScale(0.5, 0.44) -- middle of the screen (a bit up for the bar)
local TEXTURE_SIZE = 0.78 -- size of centre texture (fraction of screen height)
local UI_SIZE = 0.5 -- size of the UI (fraction of screen height)

local ACCENT = Color3.fromRGB(90, 140, 255)
local ACCENT_LIGHT = Color3.fromRGB(150, 220, 255)

local TIPS = {
	"Tap the center to begin",
	"Good things take a little time",
	"Getting everything ready for you",
	"Almost there, hang tight",
}

local finished = false -- stops all the loops when we fade out

---------------------------------------------------------------------
-- HELPERS
---------------------------------------------------------------------
local function makeSound(id, volume, looped)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume
	s.Looped = looped or false
	s.Parent = playerGui
	return s
end

local function round(obj, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = radius or UDim.new(1, 0)
	c.Parent = obj
	return c
end

-- loads an image id; if it is a Decal id (blank), falls back to its thumbnail
local function setImage(label, id)
	label.Image = "rbxassetid://" .. id
	task.spawn(function()
		pcall(function()
			ContentProvider:PreloadAsync({ label }, function(_, status)
				if status ~= Enum.AssetFetchStatus.Success then
					label.Image = "rbxthumb://type=Asset&id=" .. id .. "&w=420&h=420"
				end
			end)
		end)
	end)
end

-- fades every visible property of an object and all its children
local function fadeOut(root, duration)
	local info = TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	local function fade(obj)
		local goal = {}
		if obj:IsA("GuiObject") then
			goal.BackgroundTransparency = 1
		end
		if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
			goal.ImageTransparency = 1
		end
		if obj:IsA("TextLabel") or obj:IsA("TextButton") then
			goal.TextTransparency = 1
			goal.TextStrokeTransparency = 1
		end
		if obj:IsA("UIStroke") then
			goal.Transparency = 1
		end
		if next(goal) then
			TweenService:Create(obj, info, goal):Play()
		end
	end
	fade(root)
	for _, d in ipairs(root:GetDescendants()) do
		fade(d)
	end
end

-- hide the default Roblox UI while loading
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
end)

---------------------------------------------------------------------
-- SCREEN GUI (covers EVERYTHING, even the top bar area)
---------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "LoadingScreen"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.DisplayOrder = 9999
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
pcall(function()
	gui.ScreenInsets = Enum.ScreenInsets.None
end)
gui.Parent = playerGui

-- background (no blank spots)
local bg = Instance.new("Frame")
bg.Name = "Background"
bg.Size = UDim2.fromScale(1, 1)
bg.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
bg.BorderSizePixel = 0
bg.ZIndex = 1
bg.Parent = gui

local bgGrad = Instance.new("UIGradient")
bgGrad.Color = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(26, 30, 58)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(12, 14, 28)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(5, 6, 12)),
})
bgGrad.Rotation = 90
bgGrad.Parent = bg

-- soft vignette (dark edges)
local vignette = Instance.new("Frame")
vignette.Name = "Vignette"
vignette.Size = UDim2.fromScale(1, 1)
vignette.BackgroundColor3 = Color3.new(0, 0, 0)
vignette.BorderSizePixel = 0
vignette.ZIndex = 3
vignette.Parent = gui

local vigGrad = Instance.new("UIGradient")
vigGrad.Transparency = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0.35),
	NumberSequenceKeypoint.new(0.5, 1),
	NumberSequenceKeypoint.new(1, 0.35),
})
vigGrad.Rotation = 0
vigGrad.Parent = vignette

---------------------------------------------------------------------
-- FLOATING PARTICLES
---------------------------------------------------------------------
local particles = {}
for _ = 1, 30 do
	local size = math.random(3, 8)
	local p = Instance.new("Frame")
	p.Name = "Particle"
	p.Size = UDim2.fromOffset(size, size)
	p.AnchorPoint = Vector2.new(0.5, 0.5)
	p.Position = UDim2.fromScale(math.random(), math.random())
	p.BackgroundColor3 = ACCENT_LIGHT
	p.BackgroundTransparency = 0.55 + math.random() * 0.35
	p.BorderSizePixel = 0
	p.ZIndex = 2
	round(p)
	p.Parent = gui
	table.insert(particles, {
		obj = p,
		x = p.Position.X.Scale,
		y = p.Position.Y.Scale,
		speed = 0.015 + math.random() * 0.035,
		phase = math.random() * math.pi * 2,
	})
end

task.spawn(function()
	local t = 0
	while not finished and gui.Parent do
		local dt = RunService.RenderStepped:Wait()
		t += dt
		for _, d in ipairs(particles) do
			d.y -= d.speed * dt
			if d.y < -0.05 then
				d.y = 1.05
				d.x = math.random()
			end
			d.obj.Position = UDim2.fromScale(d.x + math.sin(t * 0.6 + d.phase) * 0.01, d.y)
		end
	end
end)

---------------------------------------------------------------------
-- GLOW RINGS behind the centre
---------------------------------------------------------------------
local rings = {}
for i = 1, 2 do
	local ring = Instance.new("Frame")
	ring.Name = "Ring" .. i
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	ring.Position = CENTER
	ring.SizeConstraint = Enum.SizeConstraint.RelativeYY
	ring.Size = UDim2.fromScale(0.8, 0.8)
	ring.BackgroundTransparency = 1
	ring.ZIndex = 2
	round(ring)

	local stroke = Instance.new("UIStroke")
	stroke.Color = ACCENT
	stroke.Thickness = 2
	stroke.Transparency = 0.6
	stroke.Parent = ring

	ring.Parent = gui
	table.insert(rings, { frame = ring, stroke = stroke, offset = (i - 1) * 0.5 })
end

---------------------------------------------------------------------
-- CENTRE TEXTURE (splits in half when the UI is pressed)
---------------------------------------------------------------------
local textureHolder = Instance.new("Frame")
textureHolder.Name = "TextureHolder"
textureHolder.AnchorPoint = Vector2.new(0.5, 0.5)
textureHolder.Position = CENTER
textureHolder.SizeConstraint = Enum.SizeConstraint.RelativeYY
textureHolder.Size = UDim2.fromScale(TEXTURE_SIZE, TEXTURE_SIZE)
textureHolder.BackgroundTransparency = 1
textureHolder.ZIndex = 4
textureHolder.Parent = gui

local function makeHalf(name, posX, imgPosX)
	local half = Instance.new("Frame")
	half.Name = name
	half.Position = UDim2.fromScale(posX, 0)
	half.Size = UDim2.fromScale(0.5, 1)
	half.BackgroundTransparency = 1
	half.ClipsDescendants = true
	half.ZIndex = 4
	half.Parent = textureHolder

	local img = Instance.new("ImageLabel")
	img.Name = "Texture"
	img.Position = UDim2.fromScale(imgPosX, 0)
	img.Size = UDim2.fromScale(2, 1) -- twice the half = the whole texture
	img.BackgroundTransparency = 1
	img.ScaleType = Enum.ScaleType.Fit
	img.ImageTransparency = 0
	img.ZIndex = 4
	img.Parent = half
	setImage(img, ID_TEXTURE)
	return half, img
end

local leftHalf, leftImg = makeHalf("LeftHalf", 0, 0)
local rightHalf, rightImg = makeHalf("RightHalf", 0.5, -1)

---------------------------------------------------------------------
-- CLICKABLE UI (centre of the screen)
---------------------------------------------------------------------
local uiButton = Instance.new("ImageButton")
uiButton.Name = "MainUI"
uiButton.AnchorPoint = Vector2.new(0.5, 0.5)
uiButton.Position = CENTER
uiButton.SizeConstraint = Enum.SizeConstraint.RelativeYY
uiButton.Size = UDim2.fromScale(UI_SIZE, UI_SIZE)
uiButton.BackgroundTransparency = 1
uiButton.ScaleType = Enum.ScaleType.Fit
uiButton.AutoButtonColor = false
uiButton.ZIndex = 6
uiButton.Parent = gui
setImage(uiButton, ID_UI)

local clicked = false

-- hover / press feel
local function sizeTween(obj, scale, t)
	TweenService:Create(
		obj,
		TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = UDim2.fromScale(scale, scale) }
	):Play()
end
uiButton.MouseEnter:Connect(function()
	if not clicked then
		sizeTween(uiButton, UI_SIZE * 1.06, 0.2)
	end
end)
uiButton.MouseLeave:Connect(function()
	if not clicked then
		sizeTween(uiButton, UI_SIZE, 0.2)
	end
end)
uiButton.MouseButton1Down:Connect(function()
	if not clicked then
		sizeTween(uiButton, UI_SIZE * 0.94, 0.1)
	end
end)

-- floating, breathing motion + ring pulses (one smooth loop)
task.spawn(function()
	local t0 = os.clock()
	while not finished and gui.Parent do
		local t = os.clock() - t0
		local float = math.sin(t * 1.2) * 0.008
		uiButton.Position = UDim2.fromScale(CENTER.X.Scale, CENTER.Y.Scale + float)
		textureHolder.Position = UDim2.fromScale(CENTER.X.Scale, CENTER.Y.Scale + float * 0.6)
		textureHolder.Rotation = math.sin(t * 0.4) * 1.2

		for _, r in ipairs(rings) do
			local p = ((t * 0.25) + r.offset) % 1
			local s = 0.8 + p * 0.35
			r.frame.Size = UDim2.fromScale(s, s)
			r.stroke.Transparency = 0.4 + p * 0.6
		end
		RunService.RenderStepped:Wait()
	end
end)

---------------------------------------------------------------------
-- LOADING TEXT (calm shake)
---------------------------------------------------------------------
local loadingText = Instance.new("TextLabel")
loadingText.Name = "LoadingText"
loadingText.AnchorPoint = Vector2.new(0.5, 0.5)
loadingText.Position = UDim2.fromScale(0.5, 0.78)
loadingText.Size = UDim2.fromScale(0.5, 0.08)
loadingText.BackgroundTransparency = 1
loadingText.Text = "Loading"
loadingText.TextColor3 = Color3.fromRGB(255, 255, 255)
loadingText.Font = Enum.Font.GothamBold
loadingText.TextScaled = true
loadingText.ZIndex = 8
loadingText.Parent = gui

local textGrad = Instance.new("UIGradient")
textGrad.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), ACCENT_LIGHT)
textGrad.Rotation = 90
textGrad.Parent = loadingText

local textStroke = Instance.new("UIStroke")
textStroke.Thickness = 2
textStroke.Color = ACCENT
textStroke.Transparency = 0.45
textStroke.Parent = loadingText

local textLimit = Instance.new("UITextSizeConstraint")
textLimit.MaxTextSize = 56
textLimit.Parent = loadingText

task.spawn(function()
	local base = loadingText.Position
	local seed = math.random() * 100
	while not finished and gui.Parent do
		local t = os.clock() * 0.9
		loadingText.Position = base + UDim2.fromOffset(math.noise(t, seed) * 6, math.noise(seed, t) * 4)
		loadingText.Rotation = math.noise(t, seed, 5) * 2.5
		RunService.RenderStepped:Wait()
	end
end)

task.spawn(function()
	local dots = 0
	while not finished and gui.Parent do
		loadingText.Text = "Loading" .. string.rep(".", dots)
		dots = (dots + 1) % 4
		task.wait(0.45)
	end
end)

---------------------------------------------------------------------
-- TIP / HINT TEXT
---------------------------------------------------------------------
local tip = Instance.new("TextLabel")
tip.Name = "Tip"
tip.AnchorPoint = Vector2.new(0.5, 0.5)
tip.Position = UDim2.fromScale(0.5, 0.94)
tip.Size = UDim2.fromScale(0.6, 0.035)
tip.BackgroundTransparency = 1
tip.Text = TIPS[1]
tip.TextColor3 = Color3.fromRGB(170, 185, 230)
tip.Font = Enum.Font.Gotham
tip.TextScaled = true
tip.ZIndex = 8
tip.Parent = gui

local tipLimit = Instance.new("UITextSizeConstraint")
tipLimit.MaxTextSize = 20
tipLimit.Parent = tip

task.spawn(function()
	local i = 1
	while not finished and gui.Parent do
		task.wait(3.5)
		if finished then
			break
		end
		TweenService:Create(tip, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		task.wait(0.45)
		i = i % #TIPS + 1
		tip.Text = TIPS[i]
		TweenService:Create(tip, TweenInfo.new(0.4), { TextTransparency = 0 }):Play()
	end
end)

---------------------------------------------------------------------
-- LOADING BAR (slowly fills over LOAD_TIME, with a shimmer)
---------------------------------------------------------------------
local barBack = Instance.new("Frame")
barBack.Name = "BarBack"
barBack.AnchorPoint = Vector2.new(0.5, 0.5)
barBack.Position = UDim2.fromScale(0.5, 0.855)
barBack.Size = UDim2.fromScale(0.45, 0.022)
barBack.BackgroundColor3 = Color3.fromRGB(28, 33, 62)
barBack.BorderSizePixel = 0
barBack.ZIndex = 8
round(barBack)
barBack.Parent = gui

local barStroke = Instance.new("UIStroke")
barStroke.Color = ACCENT
barStroke.Thickness = 1.5
barStroke.Transparency = 0.5
barStroke.Parent = barBack

local barFill = Instance.new("Frame")
barFill.Name = "BarFill"
barFill.Size = UDim2.fromScale(0, 1)
barFill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
barFill.BorderSizePixel = 0
barFill.ZIndex = 9
round(barFill)
barFill.Parent = barBack

local fillGrad = Instance.new("UIGradient")
fillGrad.Color = ColorSequence.new({
	ColorSequenceKeypoint.new(0, ACCENT),
	ColorSequenceKeypoint.new(0.5, ACCENT_LIGHT),
	ColorSequenceKeypoint.new(1, ACCENT),
})
fillGrad.Offset = Vector2.new(-1, 0)
fillGrad.Parent = barFill

TweenService:Create(
	fillGrad,
	TweenInfo.new(1.6, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1),
	{ Offset = Vector2.new(1, 0) }
):Play()

local percent = Instance.new("TextLabel")
percent.Name = "Percent"
percent.AnchorPoint = Vector2.new(0.5, 0.5)
percent.Position = UDim2.fromScale(0.5, 0.9)
percent.Size = UDim2.fromScale(0.2, 0.035)
percent.BackgroundTransparency = 1
percent.Text = "0%"
percent.TextColor3 = Color3.fromRGB(210, 220, 255)
percent.Font = Enum.Font.GothamMedium
percent.TextScaled = true
percent.ZIndex = 8
percent.Parent = gui

local percentLimit = Instance.new("UITextSizeConstraint")
percentLimit.MaxTextSize = 22
percentLimit.Parent = percent

TweenService:Create(
	barFill,
	TweenInfo.new(LOAD_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),
	{ Size = UDim2.fromScale(1, 1) }
):Play()

task.spawn(function()
	while not finished and gui.Parent do
		percent.Text = math.floor(barFill.Size.X.Scale * 100) .. "%"
		RunService.RenderStepped:Wait()
	end
end)

---------------------------------------------------------------------
-- MUSIC
---------------------------------------------------------------------
local music = makeSound(SND_MUSIC, 0.6, true)
music:Play()

---------------------------------------------------------------------
-- CLICK: sound + zoom texture + split texture
---------------------------------------------------------------------
uiButton.Activated:Connect(function()
	if clicked then
		return
	end
	clicked = true
	sizeTween(uiButton, UI_SIZE, 0.15)

	local click = makeSound(SND_CLICK, 1, false)
	click:Play()
	click.Ended:Once(function()
		click:Destroy()
	end)

	-- zoom texture: starts in the middle of the UI, zooms in, fades away
	local zoom = Instance.new("ImageLabel")
	zoom.Name = "ZoomTexture"
	zoom.AnchorPoint = Vector2.new(0.5, 0.5)
	zoom.Position = UDim2.fromScale(0.5, 0.5)
	zoom.Size = UDim2.fromScale(0.05, 0.05)
	zoom.BackgroundTransparency = 1
	zoom.ScaleType = Enum.ScaleType.Fit
	zoom.ImageTransparency = 0
	zoom.ZIndex = 10
	zoom.Parent = uiButton
	setImage(zoom, ID_ZOOM)

	local zoomTime = 1.6
	TweenService:Create(
		zoom,
		TweenInfo.new(zoomTime, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
		{ Size = UDim2.fromScale(12, 12) }
	):Play()
	TweenService:Create(
		zoom,
		TweenInfo.new(zoomTime, Enum.EasingStyle.Sine, Enum.EasingDirection.In),
		{ ImageTransparency = 1 }
	):Play()
	task.delay(zoomTime + 0.1, function()
		zoom:Destroy()
	end)

	-- centre texture splits in half and fades away
	local splitInfo = TweenInfo.new(1.8, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)
	TweenService:Create(leftHalf, splitInfo, { Position = UDim2.fromScale(-0.7, 0) }):Play()
	TweenService:Create(rightHalf, splitInfo, { Position = UDim2.fromScale(1.2, 0) }):Play()
	TweenService:Create(leftImg, splitInfo, { ImageTransparency = 1 }):Play()
	TweenService:Create(rightImg, splitInfo, { ImageTransparency = 1 }):Play()

	-- slide the tip out of the way
	TweenService:Create(tip, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
end)

---------------------------------------------------------------------
-- AFTER 20 SECONDS: fade everything (music too) + finish sound
---------------------------------------------------------------------
task.wait(LOAD_TIME)
finished = true -- stop the loops so they don't fight the fade

local finish = makeSound(SND_FINISH, 1, false)
finish:Play()

fadeOut(bg, FADE_TIME)
fadeOut(vignette, FADE_TIME)
for _, d in ipairs(particles) do
	fadeOut(d.obj, FADE_TIME)
end
for _, r in ipairs(rings) do
	fadeOut(r.frame, FADE_TIME)
end
fadeOut(textureHolder, FADE_TIME)
fadeOut(uiButton, FADE_TIME)
fadeOut(loadingText, FADE_TIME)
fadeOut(tip, FADE_TIME)
fadeOut(barBack, FADE_TIME)
fadeOut(percent, FADE_TIME)

TweenService:Create(music, TweenInfo.new(FADE_TIME), { Volume = 0 }):Play()

task.wait(FADE_TIME + 0.2)

music:Stop()
music:Destroy()
gui:Destroy()

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true)
end)

finish.Ended:Once(function()
	finish:Destroy()
